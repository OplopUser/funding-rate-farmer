# Solana RPC used to read Drift market accounts (read-only).
# Any mainnet RPC works, e.g. a Helius URL. Defaults to the public endpoint.
# HELIOS_RPC_URL is still accepted as a deprecated alias.
HELIUS_RPC_URL=https://api.mainnet-beta.solana.com

# Hyperliquid public API
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# Default filters for scan/farm
MIN_APR_PERCENT=20
MIN_OPEN_INTEREST_USD=100000

# Where paper positions are stored (relative to the working directory)
POSITIONS_FILE=data/positions.json
