{
  "name": "funding-rate-farmer",
  "version": "0.2.0",
  "description": "Perp funding-rate scanner (Hyperliquid, Drift) with paper trading",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "funding-rate-farmer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "farm": "tsx src/cli.ts farm",
    "status": "tsx src/cli.ts status",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@drift-labs/sdk": "^2.156.0",
    "@solana/web3.js": "^1.98.0",
    "chalk": "^5.6.0",
    "commander": "^14.0.0",
    "dotenv": "^17.4.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ]
}
